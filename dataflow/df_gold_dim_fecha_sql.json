{
	"name": "df_gold_dim_fecha_sql",
	"properties": {
		"folder": {
			"name": "Gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_gold_dim_fecha_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_gold_dim_fecha_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "Derivadas"
				}
			],
			"scriptLines": [
				"source(output(",
				"          fecha_completa as date",
				"     ),",
				"     allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT fecha AS fecha_completa FROM (SELECT admission_date AS fecha FROM silver.admissions UNION SELECT discharge_date FROM silver.admissions UNION SELECT payment_date FROM silver.billing) AS fechas WHERE fecha IS NOT NULL AND NOT EXISTS (SELECT 1 FROM gold.dim_fecha g WHERE g.fecha_key = CONVERT(int, CONVERT(char(8), fechas.fecha, 112)))',",
				"     format: 'query') ~> source1",
				"source1 derive(fecha_key = toInteger(toString(fecha_completa, 'yyyyMMdd')),",
				"          anio = toShort(year(fecha_completa)),",
				"          trimestre = toShort(toInteger(ceil(month(fecha_completa) / 3.0))),",
				"          trimestre_nombre = concat('T', toString(toInteger(ceil(month(fecha_completa) / 3.0)))),",
				"          mes = toShort(month(fecha_completa)),",
				"          mes_nombre = initCap(toString(fecha_completa, 'MMMM', 'es-ES')),",
				"          mes_corto = substring(initCap(toString(fecha_completa, 'MMMM', 'es-ES')), 1, 3),",
				"          semana_anio = toShort(weekOfYear(fecha_completa)),",
				"          dia_mes = toShort(dayOfMonth(fecha_completa)),",
				"          dia_semana = toShort(((dayOfWeek(fecha_completa) + 5) % 7 + 1)),",
				"          dia_nombre = initCap(toString(fecha_completa, 'EEEE', 'es-ES')),",
				"          es_fin_de_semana = ((dayOfWeek(fecha_completa) + 5) % 7 + 1) >= 6) ~> Derivadas",
				"Derivadas sink(allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     input(",
				"          fecha_key as integer,",
				"          fecha_completa as date,",
				"          anio as integer,",
				"          trimestre as integer,",
				"          trimestre_nombre as string,",
				"          mes as integer,",
				"          mes_nombre as string,",
				"          mes_corto as string,",
				"          semana_anio as integer,",
				"          dia_mes as integer,",
				"          dia_semana as integer,",
				"          dia_nombre as string,",
				"          es_fin_de_semana as boolean",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          fecha_completa,",
				"          fecha_key,",
				"          anio,",
				"          trimestre,",
				"          trimestre_nombre,",
				"          mes,",
				"          mes_nombre,",
				"          mes_corto,",
				"          semana_anio,",
				"          dia_mes,",
				"          dia_semana,",
				"          dia_nombre,",
				"          es_fin_de_semana",
				"     )) ~> sink1"
			]
		}
	}
}