{
	"name": "df_silver_admissions_sql",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "sql_bronze_admissions",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_admissions_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "IDs"
				},
				{
					"name": "Fechas"
				},
				{
					"name": "Departamento"
				}
			],
			"scriptLines": [
				"source(output(",
				"          admission_id as string,",
				"          patient_id as string,",
				"          admission_date as string,",
				"          discharge_date as string,",
				"          department as string,",
				"          attending_doctor_id as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(admission_id = toInteger(trim(admission_id)),",
				"          patient_id = toInteger(trim(patient_id)),",
				"          attending_doctor_id = toInteger(trim(attending_doctor_id))) ~> IDs",
				"IDs derive(admission_date = toDate(trim(admission_date), 'yyyy-MM-dd'),",
				"          discharge_date = toDate(trim(discharge_date), 'yyyy-MM-dd')) ~> Fechas",
				"Fechas derive(department = case(\r",
				"    lower(trim(department)) == 'cardiology', 'Cardiology',\r",
				"    lower(trim(department)) == 'onco' || lower(trim(department)) == 'oncology', 'Oncology',\r",
				"    lower(trim(department)) == 'er' || lower(trim(department)) == 'emergency', 'Emergency',\r",
				"    lower(trim(department)) == 'gen surg' || lower(trim(department)) == 'general surgery' || lower(trim(department)) == 'generalsurgery', 'General Surgery',\r",
				"    lower(trim(department)) == 'neuro' || lower(trim(department)) == 'neurology' || lower(trim(department)) == 'nuerology', 'Neurology',\r",
				"    lower(trim(department)) == 'paediatrics' || lower(trim(department)) == 'pediatrics', 'Pediatrics',\r",
				"    lower(trim(department)) == 'ortho' || lower(trim(department)) == 'orthopedics', 'Orthopedics',\r",
				"    trim(department)\r",
				")) ~> Departamento",
				"Departamento sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          admission_id as integer,",
				"          patient_id as integer,",
				"          admission_date as date,",
				"          discharge_date as date,",
				"          department as string,",
				"          attending_doctor_id as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}