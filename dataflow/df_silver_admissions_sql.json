{
	"name": "df_silver_admissions_sql",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "sql_bronze_admissions",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_admissions_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "IDs"
				},
				{
					"name": "Fechas"
				},
				{
					"name": "Departamento"
				},
				{
					"name": "ValidarAdmissions"
				}
			],
			"scriptLines": [
				"source(output(",
				"          admission_id as string,",
				"          patient_id as string,",
				"          admission_date as string,",
				"          discharge_date as string,",
				"          department as string,",
				"          attending_doctor_id as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(admission_id = toInteger(trim(admission_id)),",
				"          patient_id = toInteger(trim(patient_id)),",
				"          attending_doctor_id = toInteger(trim(attending_doctor_id))) ~> IDs",
				"IDs derive(admission_date = case(",
				"    regexMatch(trim(admission_date), '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'),",
				"        toDate(trim(admission_date), 'yyyy-MM-dd'),",
				"    regexMatch(trim(admission_date), '^[0-9]{2}-[0-9]{2}-[0-9]{2}$'),",
				"        toDate(concat(substring(trim(admission_date), 1, 6), '20', substring(trim(admission_date), 7, 2)), 'MM-dd-yyyy'),",
				"    regexMatch(trim(admission_date), '^[0-9]{1,2}/[0-9]{1,2}/[0-9]{4}$'),",
				"        toDate(trim(admission_date), 'M/d/yyyy'),",
				"    regexMatch(trim(admission_date), '^[0-9]{1,2}-[A-Za-z]{3}-[0-9]{4}$'),",
				"        toDate(trim(admission_date), 'd-MMM-yyyy'),",
				"    regexMatch(trim(admission_date), '^[A-Za-z]+ [0-9]{1,2}, [0-9]{4}$'),",
				"        toDate(trim(admission_date), 'MMMM d, yyyy'),",
				"    toDate(null())",
				"),",
				"          discharge_date = case(",
				"    regexMatch(trim(discharge_date), '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'),",
				"        toDate(trim(discharge_date), 'yyyy-MM-dd'),",
				"    regexMatch(trim(discharge_date), '^[0-9]{2}-[0-9]{2}-[0-9]{2}$'),",
				"        toDate(concat(substring(trim(discharge_date), 1, 6), '20', substring(trim(discharge_date), 7, 2)), 'MM-dd-yyyy'),",
				"    regexMatch(trim(discharge_date), '^[0-9]{1,2}/[0-9]{1,2}/[0-9]{4}$'),",
				"        toDate(trim(discharge_date), 'M/d/yyyy'),",
				"    regexMatch(trim(discharge_date), '^[0-9]{1,2}-[A-Za-z]{3}-[0-9]{4}$'),",
				"        toDate(trim(discharge_date), 'd-MMM-yyyy'),",
				"    regexMatch(trim(discharge_date), '^[A-Za-z]+ [0-9]{1,2}, [0-9]{4}$'),",
				"        toDate(trim(discharge_date), 'MMMM d, yyyy'),",
				"    toDate(null())",
				")) ~> Fechas",
				"Fechas derive(department = case(",
				"    lower(trim(department)) == 'cardiology', 'Cardiology',",
				"    lower(trim(department)) == 'onco' || lower(trim(department)) == 'oncology', 'Oncology',",
				"    lower(trim(department)) == 'er' || lower(trim(department)) == 'emergency', 'Emergency',",
				"    lower(trim(department)) == 'gen surg' || lower(trim(department)) == 'general surgery' || lower(trim(department)) == 'generalsurgery', 'General Surgery',",
				"    lower(trim(department)) == 'neuro' || lower(trim(department)) == 'neurology' || lower(trim(department)) == 'nuerology', 'Neurology',",
				"    lower(trim(department)) == 'paediatrics' || lower(trim(department)) == 'pediatrics', 'Pediatrics',",
				"    lower(trim(department)) == 'ortho' || lower(trim(department)) == 'orthopedics', 'Orthopedics',",
				"    trim(department)",
				")) ~> Departamento",
				"Departamento split(!isNull(admission_id) && !isNull(patient_id) && !isNull(attending_doctor_id) && !isNull(admission_date) && !isNull(department) && length(trim(department)) > 0 && length(department) <= 100 && (isNull(discharge_date) || discharge_date >= admission_date),",
				"     disjoint: false) ~> ValidarAdmissions@(ParaSilver, ParaRevision)",
				"ValidarAdmissions@ParaSilver sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          admission_id as integer,",
				"          patient_id as integer,",
				"          admission_date as date,",
				"          discharge_date as date,",
				"          department as string,",
				"          attending_doctor_id as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}