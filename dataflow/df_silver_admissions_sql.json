{
	"name": "df_silver_admissions_sql",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "sql_bronze_admissions",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_admissions_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "IDs"
				},
				{
					"name": "Fechas"
				},
				{
					"name": "Departamento"
				}
			],
			"scriptLines": [
				"source(output(",
				"          admission_id as string,",
				"          patient_id as string,",
				"          admission_date as string,",
				"          discharge_date as string,",
				"          department as string,",
				"          attending_doctor_id as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(admission_id = toInteger(trim(admission_id)),",
				"          patient_id = toInteger(trim(patient_id)),",
				"          attending_doctor_id = toInteger(trim(attending_doctor_id))) ~> IDs",
				"IDs derive(admission_date = case(\r",
				"    regexMatch(trim(admission_date), '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'),\r",
				"        toDate(trim(admission_date), 'yyyy-MM-dd'),\r",
				"    regexMatch(trim(admission_date), '^[0-9]{2}-[0-9]{2}-[0-9]{2}$'),\r",
				"        toDate(concat(substring(trim(admission_date), 1, 6), '20', substring(trim(admission_date), 7, 2)), 'MM-dd-yyyy'),\r",
				"    regexMatch(trim(admission_date), '^[0-9]{1,2}/[0-9]{1,2}/[0-9]{4}$'),\r",
				"        toDate(trim(admission_date), 'M/d/yyyy'),\r",
				"    regexMatch(trim(admission_date), '^[0-9]{1,2}-[A-Za-z]{3}-[0-9]{4}$'),\r",
				"        toDate(trim(admission_date), 'd-MMM-yyyy'),\r",
				"    regexMatch(trim(admission_date), '^[A-Za-z]+ [0-9]{1,2}, [0-9]{4}$'),\r",
				"        toDate(trim(admission_date), 'MMMM d, yyyy'),\r",
				"    toDate(null())\r",
				"),",
				"          discharge_date = case(\r",
				"    regexMatch(trim(discharge_date), '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'),\r",
				"        toDate(trim(discharge_date), 'yyyy-MM-dd'),\r",
				"    regexMatch(trim(discharge_date), '^[0-9]{2}-[0-9]{2}-[0-9]{2}$'),\r",
				"        toDate(concat(substring(trim(discharge_date), 1, 6), '20', substring(trim(discharge_date), 7, 2)), 'MM-dd-yyyy'),\r",
				"    regexMatch(trim(discharge_date), '^[0-9]{1,2}/[0-9]{1,2}/[0-9]{4}$'),\r",
				"        toDate(trim(discharge_date), 'M/d/yyyy'),\r",
				"    regexMatch(trim(discharge_date), '^[0-9]{1,2}-[A-Za-z]{3}-[0-9]{4}$'),\r",
				"        toDate(trim(discharge_date), 'd-MMM-yyyy'),\r",
				"    regexMatch(trim(discharge_date), '^[A-Za-z]+ [0-9]{1,2}, [0-9]{4}$'),\r",
				"        toDate(trim(discharge_date), 'MMMM d, yyyy'),\r",
				"    toDate(null())\r",
				")) ~> Fechas",
				"Fechas derive(department = case(\r",
				"    lower(trim(department)) == 'cardiology', 'Cardiology',\r",
				"    lower(trim(department)) == 'onco' || lower(trim(department)) == 'oncology', 'Oncology',\r",
				"    lower(trim(department)) == 'er' || lower(trim(department)) == 'emergency', 'Emergency',\r",
				"    lower(trim(department)) == 'gen surg' || lower(trim(department)) == 'general surgery' || lower(trim(department)) == 'generalsurgery', 'General Surgery',\r",
				"    lower(trim(department)) == 'neuro' || lower(trim(department)) == 'neurology' || lower(trim(department)) == 'nuerology', 'Neurology',\r",
				"    lower(trim(department)) == 'paediatrics' || lower(trim(department)) == 'pediatrics', 'Pediatrics',\r",
				"    lower(trim(department)) == 'ortho' || lower(trim(department)) == 'orthopedics', 'Orthopedics',\r",
				"    trim(department)\r",
				")) ~> Departamento",
				"Departamento sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          admission_id as integer,",
				"          patient_id as integer,",
				"          admission_date as date,",
				"          discharge_date as date,",
				"          department as string,",
				"          attending_doctor_id as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}