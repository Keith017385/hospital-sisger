{
	"name": "df_gold_cargar_facturacion",
	"properties": {
		"folder": {
			"name": "Gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_silver_billing_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "df_gold_fact_facturacion_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [],
			"scriptLines": [
				"source(output(",
				"          billing_id_bk as integer,",
				"          admission_id_bk as integer,",
				"          paciente_key as integer,",
				"          departamento_key as integer,",
				"          servicio_cargo_key as integer,",
				"          fecha_pago_key as integer,",
				"          monto_facturado as decimal(12,2),",
				"          conteo_transacciones as integer",
				"     ),",
				"     allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT b.billing_id AS billing_id_bk,b.admission_id AS admission_id_bk,p.paciente_key,dep.departamento_key,sc.servicio_cargo_key,fp.fecha_key AS fecha_pago_key,b.amount AS monto_facturado,1 AS conteo_transacciones FROM silver.billing b JOIN silver.admissions a ON a.admission_id=b.admission_id JOIN gold.dim_paciente p ON p.patient_id_bk=a.patient_id JOIN gold.dim_departamento dep ON dep.nombre_departamento=a.department JOIN gold.dim_servicio_cargo sc ON sc.tipo_cargo=b.charge_type AND sc.estado_pago=b.payment_status LEFT JOIN gold.dim_fecha fp ON fp.fecha_key=CONVERT(int,CONVERT(char(8),b.payment_date,112)) WHERE (b.payment_date IS NULL OR fp.fecha_key IS NOT NULL) AND NOT EXISTS (SELECT 1 FROM gold.fact_facturacion g WHERE g.billing_id_bk=b.billing_id)',",
				"     format: 'query') ~> source1",
				"source1 sink(allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     input(",
				"          facturacion_key as long,",
				"          billing_id_bk as integer,",
				"          admission_id_bk as integer,",
				"          paciente_key as integer,",
				"          departamento_key as integer,",
				"          servicio_cargo_key as integer,",
				"          fecha_pago_key as integer,",
				"          monto_facturado as decimal(12,2),",
				"          conteo_transacciones as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          billing_id_bk,",
				"          admission_id_bk,",
				"          paciente_key,",
				"          departamento_key,",
				"          servicio_cargo_key,",
				"          fecha_pago_key,",
				"          monto_facturado,",
				"          conteo_transacciones",
				"     )) ~> sink1"
			]
		}
	}
}