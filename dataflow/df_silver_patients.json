{
	"name": "df_silver_patients",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "sql_bronze_patients",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_patients_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "IDs"
				},
				{
					"name": "Texto"
				},
				{
					"name": "Fechas"
				},
				{
					"name": "ValidarFilas"
				}
			],
			"scriptLines": [
				"source(output(",
				"          patient_id as string,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as string,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(patient_id = toInteger(trim(patient_id))) ~> IDs",
				"IDs derive(full_name = trim(full_name),",
				"          gender = trim(gender),",
				"          phone = trim(phone),",
				"          email = lower(trim(email)),",
				"          address = trim(address),",
				"          insurance_provider = trim(insurance_provider)) ~> Texto",
				"Texto derive(FechaOriginal = date_of_birth,",
				"          date_of_birth = case(regexMatch(trim(date_of_birth), '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'), toDate(trim(date_of_birth), 'yyyy-MM-dd'), regexMatch(trim(date_of_birth), '^[0-9]{1,2}/[0-9]{1,2}/[0-9]{4}$'), toDate(trim(date_of_birth), 'M/d/yyyy'), regexMatch(trim(date_of_birth), '^[0-9]{1,2}-[A-Za-z]{3}-[0-9]{4}$'), toDate(trim(date_of_birth), 'd-MMM-yyyy'), regexMatch(trim(date_of_birth), '^[A-Za-z]+ [0-9]{1,2}, [0-9]{4}$'), toDate(trim(date_of_birth), 'MMMM d, yyyy'), toDate(null()))) ~> Fechas",
				"Fechas split(!isNull(patient_id) && (!isNull(full_name) && length(full_name) > 0 && length(full_name) <= 250) && (isNull(gender) || length(gender) <= 10) && (isNull(phone) || length(phone) <= 50) && (isNull(email) || length(email) <= 255) && (isNull(address) || length(address) <= 500) && (isNull(insurance_provider) || length(insurance_provider) <= 150) && (isNull(FechaOriginal) || length(trim(FechaOriginal)) == 0 || (!isNull(date_of_birth) && date_of_birth <= currentDate())),",
				"     disjoint: false) ~> ValidarFilas@(ParaSilver, ParaRevision)",
				"ValidarFilas@ParaSilver sink(allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     input(",
				"          patient_id as integer,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as date,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          patient_id,",
				"          full_name,",
				"          gender,",
				"          date_of_birth,",
				"          phone,",
				"          email,",
				"          address,",
				"          insurance_provider",
				"     )) ~> sink1"
			]
		}
	}
}