{
	"name": "df_silver_diagnoses_sql",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "sql_bronze_diagnoses",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_diagnoses_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "IDs"
				},
				{
					"name": "Texto"
				},
				{
					"name": "ValidarFilas"
				}
			],
			"scriptLines": [
				"source(output(",
				"          diagnosis_id as string,",
				"          admission_id as string,",
				"          icd_code as string,",
				"          diagnosis_description as string,",
				"          severity as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(diagnosis_id = toInteger(trim(diagnosis_id)),",
				"          admission_id = toInteger(trim(admission_id))) ~> IDs",
				"IDs derive(icd_code = upper(trim(icd_code)),",
				"          diagnosis_description = iif(isNull(diagnosis_description) || length(trim(diagnosis_description)) == 0, toString(null()), trim(diagnosis_description)),",
				"          severity = iif(isNull(severity) || length(trim(severity)) == 0, toString(null()), lower(trim(severity)))) ~> Texto",
				"Texto split(!isNull(diagnosis_id) && !isNull(admission_id) && (!isNull(icd_code) && length(icd_code) > 0 && length(icd_code) <= 50) && (isNull(diagnosis_description) || length(diagnosis_description) <= 500) && (isNull(severity) || length(severity) <= 50),",
				"     disjoint: false) ~> ValidarFilas@(ParaSilver, ParaRevision)",
				"ValidarFilas@ParaSilver sink(allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     input(",
				"          diagnosis_id as integer,",
				"          admission_id as integer,",
				"          icd_code as string,",
				"          diagnosis_description as string,",
				"          severity as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          diagnosis_id,",
				"          admission_id,",
				"          icd_code,",
				"          diagnosis_description,",
				"          severity",
				"     )) ~> sink1"
			]
		}
	}
}